{
  "name": "dghk-familienfreizeit",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm run db:migrate:local && vite",
    "db:migrate:local": "wrangler d1 migrations apply dghk-familienfreizeit-local --local",
    "db:import-fixture": "node scripts/import-fixture.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev --no-open",
    "storybook:build": "storybook build",
    "typegen": "wrangler types",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "bench": "vitest run -c vitest.bench.config.ts",
    "bench:check": "vitest run --project kernel test/solver/work-budgets.test.ts test/solver/request-budgets.test.ts test/solver/placement-equivalence.test.ts",
    "test:room-assignment:coverage": "vitest run --project kernel --coverage",
    "test:build": "node --test test/build/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:storybook": "playwright test -c playwright.storybook.config.ts",
    "test:storybook:update": "playwright test -c playwright.storybook.config.ts --update-snapshots",
    "ci": "pnpm run format:check && pnpm run test:docs && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build && pnpm run storybook:build && pnpm run test:storybook && pnpm run test:build && pnpm run test:browser",
    "check:docs": "node scripts/check-doc-links.mjs",
    "test:docs": "node --test test/docs/*.test.mjs && pnpm run check:docs",
    "perf:report": "node --experimental-strip-types scripts/performance-history.ts",
    "bench:scale": "node --experimental-strip-types scripts/performance-bench.ts",
    "perf:export": "node --experimental-strip-types scripts/performance-export.ts",
    "perf:catalogue": "DGHK_PERF_WRITE_CATALOGUE=1 vitest run --project kernel test/events/performance-catalogue.test.ts",
    "bench:requests": "node --experimental-strip-types scripts/performance-requests.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1",
    "@bgotink/kdl": "^0.4.0",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "hono": "4.13.8",
    "lucide-react": "^1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3",
    "wouter": "^3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/vitest-plugin": "1.1.13",
    "@eslint/js": "^10",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "github-slugger": "^2.0.0",
    "globals": "^16",
    "jsdom": "^27",
    "markdown-it": "^15.0.2",
    "miniflare": "5.20260918.0-alpha",
    "oxfmt": "^0.68.0",
    "storybook": "^10.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  }
}
