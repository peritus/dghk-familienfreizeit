{
  "name": "__EXTERNAL_WORKER_NAME__",
  "account_id": "__EXTERNAL_ACCOUNT_ID__",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "DGHK_PERFORMANCE": "on" },
  "analytics_engine_datasets": [{ "binding": "PERFORMANCE", "dataset": "dghk_performance" }],
  "tail_consumers": [{ "service": "__EXTERNAL_PERFORMANCE_WORKER_NAME__" }],
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__EXTERNAL_D1_DATABASE_NAME__",
      "database_id": "__EXTERNAL_D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
