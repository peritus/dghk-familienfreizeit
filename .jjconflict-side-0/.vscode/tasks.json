{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ci",
      "type": "process",
      "command": "nix",
      "args": ["develop", "--command", "sh", "-c", "npm ci && exec npm run ci"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "dev-preview",
      "type": "process",
      "command": "nix",
      "args": ["develop", "--command", "sh", "-c", "npm ci && exec npm run dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
