// Fixed attendance claims capacity before ranked rounds. Two people compete
// for the remaining seat, and a later capacity reduction must preserve both
// the explicit fixed decision and the sign-up fact.

WorkshopSpaceAdded workshop_space_id="wsp_main" name="Halle" location_description="Erdgeschoss" capacity=12 sort_key=1
WorkshopSlotAdded slot_id="slot_morning" starts_at="2027-05-14T09:00:00+02:00" ends_at="2027-05-14T11:00:00+02:00" sort_key=1
WorkshopSlotAdded slot_id="slot_afternoon" starts_at="2027-05-14T13:00:00+02:00" ends_at="2027-05-14T15:00:00+02:00" sort_key=2
WorkshopSlotAdded slot_id="slot_late" starts_at="2027-05-14T16:00:00+02:00" ends_at="2027-05-14T18:00:00+02:00" sort_key=3

WorkshopAdded workshop_id="wks_clay" title="Tonwerkstatt" description="Mit Ton gestalten." audience="children" age_min=6 age_max=14 capacity=2 participation_mode="assigned" sort_key=1
WorkshopAdded workshop_id="wks_drawing" title="Zeichenwerkstatt" description="Gemeinsam zeichnen." audience="children" age_min=6 age_max=14 capacity=2 participation_mode="assigned" sort_key=2
WorkshopAdded workshop_id="wks_signup" title="Anmeldung" description="Eine Anmeldung bleibt ein ausdrücklicher Eintrag." audience="children" age_min=6 age_max=14 capacity=2 participation_mode="sign-up" sort_key=3

FamilyInvited family_id="fam_fixed" email="fixed@example.test" display_name="Fix" locale="de"
PersonAdded person_id="per_fixed" family_id="fam_fixed" given_name="Fix" family_name="Fix" age=12 role="child"
FamilyInvited family_id="fam_rank_a" email="rank-a@example.test" display_name="Rank A" locale="de"
PersonAdded person_id="per_rank_a" family_id="fam_rank_a" given_name="Rank A" family_name="Rank A" age=12 role="child"
FamilyInvited family_id="fam_rank_b" email="rank-b@example.test" display_name="Rank B" locale="de"
PersonAdded person_id="per_rank_b" family_id="fam_rank_b" given_name="Rank B" family_name="Rank B" age=12 role="child"
FamilyInvited family_id="fam_signup" email="signup@example.test" display_name="Signup" locale="de"
PersonAdded person_id="per_signup" family_id="fam_signup" given_name="Signup" family_name="Signup" age=12 role="child"

LabelSet entity_id="per_fixed" key="needs" value="fixed-workshop:per_fixed:wks_clay" strength="required" note=#null
LabelSet entity_id="wks_clay" key="provides" value="fixed-workshop:per_fixed:wks_clay" strength=#null note=#null
LabelSet entity_id="per_rank_a" key="prefers-workshop" value="wks_clay:1" strength=#null note=#null
LabelSet entity_id="per_rank_b" key="prefers-workshop" value="wks_clay:1" strength=#null note=#null
LabelSet entity_id="per_rank_b" key="prefers-workshop" value="wks_drawing:2" strength=#null note=#null
LabelSet entity_id="per_signup" key="signed-up-for" value="wks_signup" strength=#null note=#null
LabelSet entity_id="fam_fixed" key="family-note" value="private-workshop-note" strength=#null note=#null

// These final edits provide the prospective, over-capacity state.
LabelSet entity_id="wks_clay" key="capacity" value=0 strength=#null note=#null
LabelSet entity_id="wks_signup" key="capacity" value=0 strength=#null note=#null
