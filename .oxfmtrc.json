{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "docs/**",
    "spec/**",
    "migrations/**",
    "README.md",
    "THIRD_PARTY.md",
    "worker-configuration.d.ts"
  ]
}
