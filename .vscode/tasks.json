{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ci",
      "type": "process",
      "command": "nix",
      "args": ["develop", "--command", "sh", "-c", "npm ci && exec npm run ci"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "dev-preview",
      "type": "process",
      "command": "nix",
      "args": [
        "develop",
        "--command",
        "sh",
        "-c",
        "export DGHK_DEBUG_ONLY_DANGEROUS_SHOW_MAGIC_LINKS_ON_CONSOLE=true DGHK_DEBUG_ONLY_DANGEROUS_ALLOW_INSECURE_SESSION_COOKIES=true; npm ci && exec env CI=1 npm run dev"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "storybook",
      "type": "process",
      "command": "nix",
      "args": [
        "develop",
        "--command",
        "sh",
        "-c",
        "npm ci && exec npm run storybook -- --host \"${DGHK_STORYBOOK_BIND:-127.0.0.1}\" --port \"${DGHK_STORYBOOK_PORT:-6006}\""
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
